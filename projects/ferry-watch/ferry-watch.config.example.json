{
  "email": {
    "from": "ferry-watch@your-domain.example",
    "to": [
      "you@example.com"
    ],
    "subjectPrefix": "[ferry-watch]",
    "delivery": {
      "transport": "smtp",
      "host": "smtp.gmail.com",
      "port": 587,
      "secure": false,
      "user": "you@gmail.com",
      "passwordEnv": "FERRY_WATCH_SMTP_PASSWORD"
    }
  },
  "polling": {
    "intervalMinutes": 60,
    "jitterSeconds": 300
  },
  "alerts": {
    "renotifyAfterHours": 24,
    "notifyOnDisappear": false,
    "errorAfterConsecutiveFailures": 3
  },
  "browser": {
    "headless": true,
    "timeoutSeconds": 120,
    "selectors": {}
  },
  "statePath": "./state/ferry-watch.state.json",
  "watches": [
    {
      "id": "santander-portsmouth",
      "label": "Santander to Portsmouth",
      "enabled": true,
      "provider": "brittany-ferries",
      "routeFrom": "Santander",
      "routeTo": "Portsmouth",
      "dateFrom": "2026-09-25",
      "dateTo": "2026-10-07",
      "departAfter": null,
      "departBefore": null,
      "passengers": 2,
      "pets": 1,
      "vehicle": "car",
      "wantKinds": [
        "pet-friendly-cabin"
      ],
      "maxPrice": null
    },
    {
      "id": "portsmouth-santander",
      "label": "Portsmouth to Santander",
